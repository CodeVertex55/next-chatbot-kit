# Optional. Your Anthropic API key. Without it the chat answers with a fixed holding reply.
ANTHROPIC_API_KEY=
# Optional. The model id used for replies. Leave empty to use the kit default.
CHAT_MODEL=
# Optional. The most model calls allowed per day. Leave empty for no daily limit. 0 means no model calls at all, so the chat always gives the holding reply.
CHAT_DAILY_LIMIT=
# Optional. Extra hosts, separated by commas, that may call the chat routes. The site's own host is always allowed.
CHAT_ALLOWED_ORIGINS=
# Optional. The public address of the site, such as https://example.com. Defaults to http://localhost:3000.
SITE_URL=
# Optional. Resend API key for emailing leads. Needs LEAD_EMAIL_TO and LEAD_EMAIL_FROM as well.
RESEND_API_KEY=
# Optional. Where lead emails are sent.
LEAD_EMAIL_TO=
# Optional. The sender address for lead emails, on a domain verified with Resend.
LEAD_EMAIL_FROM=
# Optional. An https address that receives each lead as a JSON post.
LEAD_WEBHOOK_URL=
